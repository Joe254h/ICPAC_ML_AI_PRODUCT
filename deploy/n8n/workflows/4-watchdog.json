{
  "id": "IcpacWatch000004",
  "name": "ICPAC 4 · Watchdog",
  "active": false,
  "nodes": [
    {
      "id": "3d322d14-debf-534f-96e0-7c00063a1402",
      "name": "Every 30 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",

    {
      "id": "cc622c0e-f088-5984-b9e1-caaba8c893e5",
      "name": "Describe the problem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        200
      ],
      "parameters": {
        "jsCode": "// The weekly run did not finish: say what happened and where to look.\nconst op = $input.first().json;\nconst site = ($env.ICPAC_SITE_URL || '').replace(/\\/$/, '');\nconst why = op.state === 'timeout'\n  ? `It is still running after ${op.hours} hours.`\n  : `It ended with status \"${op.status}\": ${op.error || 'no reason given'}.`;\nreturn [{ json: {\n  severity: 'alert',\n  subject: 'ICPAC Week-2: the weekly forecast run needs attention',\n  text: `The weekly forecast and bulletin run (task ${op.id}) did not complete. ${why}\\n\\n`\n    + `Open the task: ${site}/data/runs?operation=${op.id}\\n`\n    + 'Start it again from n8n (workflow \"ICPAC 1\", Test workflow) or from the website\\'s Operations page.',\n} }];\n"
      }
    },
    {
      "id": "45f569fb-e11f-54aa-8e62-2a5fa50a34f2",
      "name": "Notify",

      "typeVersion": 2,
      "position": [
        220,
        200
      ],
      "parameters": {
        "jsCode": "// Started by hand: a new request identity, so a failed week can be run again.\nreturn [{ json: { fresh: true } }];\n"
      }
    },
    {
      "id": "41c3a7d0-a036-5aaa-aa6d-be2ddf8c37d3",
      "name": "Week and request identity",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "// The week this run is for: its Sunday (East Africa Time). The same week always gets the\n// same request identity, so starting again returns the week's task instead of a second run.\nconst crypto = require('crypto');\nconst eat = new Date(Date.now() + 3 * 3600 * 1000);\nconst sunday = new Date(Date.UTC(eat.getUTCFullYear(), eat.getUTCMonth(), eat.getUTCDate() - eat.getUTCDay()));\nconst week = sunday.toISOString().slice(0, 10);\nconst action = 'end_to_end';\nconst fresh = $input.first().json.fresh === true;\nconst key = fresh ? `n8n:${action}:${week}:${Date.now()}` : `n8n:${action}:${week}`;\nreturn [{ json: {\n  action, week,\n  actor: fresh ? 'n8n (started by hand)' : 'n8n weekly schedule',\n  request_id: crypto.createHash('md5').update(key).digest('hex'),\n} }];\n"
      }
    },
    {
      "id": "5c56e170-d8d9-57fa-bb75-8a8279ba0ba1",
      "name": "Start the weekly run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ICPAC_API_URL.replace(/\\/$/, '') }}/operations",
        "options": {
          "timeout": 60000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: $json.action, actor: $json.actor, request_id: $json.request_id }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "IcpacStaffKey001",
          "name": "ICPAC staff key"
        }
      }
    },
    {
      "id": "ee4867e7-3124-5bc2-a7f4-972a1f53edaa",
      "name": "Wait before checking",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        880,
        0
      ],
      "parameters": {
        "amount": "={{ Number($env.ICPAC_POLL_SECONDS || 120) }}",

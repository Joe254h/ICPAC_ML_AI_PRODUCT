        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "IcpacStaffKey001",
          "name": "ICPAC staff key"
        }
      }
    },
    {
      "id": "898e87be-daa6-5717-a240-30c5467ca146",
      "name": "Decide",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "jsCode": "// waiting: queued, running, or failed with a retry the service has scheduled;\n// done; failed; timeout (still not finished after ICPAC_RUN_TIMEOUT_HOURS).\nconst op = $input.first().json;\nconst hours = (Date.now() - Date.parse(op.created_at)) / 3.6e6;\nlet state = 'waiting';\nif (op.status === 'complete') state = 'done';\nelse if (op.status === 'failed' && !op.retry_at) state = 'failed';\nelse if (['cancelled', 'interrupted'].includes(op.status)) state = 'failed';\nconst limit = Number($env.ICPAC_RUN_TIMEOUT_HOURS || 6);\nif (state === 'waiting' && hours > limit) state = 'timeout';\nreturn [{ json: {\n  id: op.id, action: op.action, status: op.status, state,\n  hours: Math.round(hours * 10) / 10, error: op.error || null, retry_at: op.retry_at || null,\n  result: op.result || null,\n} }];\n"
      }
    },
    {
      "id": "3817a769-10b7-56e3-9b2f-4f6d53580ceb",
      "name": "Still running?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "82eda3f4-1c46-51ee-8152-34d2a3a3f3ac",
              "leftValue": "={{ $json.state }}",
              "rightValue": "waiting",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },

      },
      "webhookId": "b5a0c1f2-weekly-wait-0000-000000000001"
    },
    {
      "id": "c1f57716-ac46-5846-92f6-a5472faf6fe0",
      "name": "Read the task",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.ICPAC_API_URL.replace(/\\/$/, '') }}/operations/{{ $('Start the weekly run').first().json.id }}",
        "options": {

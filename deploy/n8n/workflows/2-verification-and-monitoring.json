    {
      "id": "b77816a6-c0a2-5300-a935-88b977f773e7",
      "name": "Request identity",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        100
      ],
      "parameters": {
        "jsCode": "// One request identity per three-hour slot (or per day for the monitoring), so a retried\n// trigger does not queue the same task twice.\nconst crypto = require('crypto');\nconst action = $input.first().json.action;\nconst now = new Date();\nconst slot = action === 'verify_due'\n  ? `${now.toISOString().slice(0, 10)}T${String(Math.floor(now.getUTCHours() / 3) * 3).padStart(2, '0')}`\n  : now.toISOString().slice(0, 10);\nreturn [{ json: {\n  action,\n  actor: 'n8n schedule',\n  request_id: crypto.createHash('md5').update(`n8n:${action}:${slot}`).digest('hex'),\n} }];\n"
      }
    },
    {
      "id": "e80350a8-c5dd-5976-8f46-2e58f27c48a7",
      "name": "Start the task",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ICPAC_API_URL.replace(/\\/$/, '') }}/operations",
        "options": {
          "timeout": 60000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: $json.action, actor: $json.actor, request_id: $json.request_id }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "IcpacStaffKey001",
          "name": "ICPAC staff key"
        }
      }
    }
  ],

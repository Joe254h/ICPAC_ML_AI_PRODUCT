# Copy to .env for local runs. Never commit real values: .env is git-ignored.
DATABASE_URL=sqlite:///data/prototype.db
# Supabase / PostgreSQL (install the "postgres" extra); postgres:// URLs are accepted as is:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
# Copilot (docs/chatbot.md). Recommended: Claude through the Anthropic API.
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=low
LLM_PROVIDER=mock
LLM_BASE_URL=http://localhost:8001/v1
LLM_MODEL=qwen-prototype
LLM_API_KEY=
# true: an OpenAI-compatible model with tool calling answers like Claude does.
LLM_TOOLS=false
# Free Gemini (docs/chatbot.md): LLM_PROVIDER=openai_compatible, LLM_TOOLS=true,
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai,
# LLM_MODEL=gemini-2.5-flash, LLM_REASONING_EFFORT=low, LLM_API_KEY=<AI Studio key>.
# Groq Qwen: set to none; leave empty for endpoints that do not accept this field.
LLM_REASONING_EFFORT=
# A model on a CPU server (docs/self-hosted-llm.md): wait longer and send fewer past messages.
LLM_TIMEOUT_SECONDS=20
LLM_HISTORY_MESSAGES=12
# true: wake a model that scales to zero when the Copilot page opens.
LLM_WARM_UP=false
# Verified model artifacts (descriptor paths are relative to this root).
ARTIFACT_ROOT=artifacts
# CHIRPS days (verification) and dekads (monitoring) are kept under DATA_ROOT/chirps.
DATA_ROOT=data/observations
# Optional: another server laid out like data.chc.ucsb.edu (a mirror or the test server).
# CHIRPS_BASE_URL=
# Optional: the 1991-2020 CHIRPS dekads (NetCDF), for percent of normal on Monitoring.
# CHIRPS_DEKAD_CLIMATOLOGY=
# Forecast product packages are written to RUN_ROOT/forecasts (persistent, shared storage).
RUN_ROOT=data/runs
# ECMWF ensembles downloaded from ECMWF Open Data, and any supplied input files
# (ecmwf_s2s_tp_<YYYY-MM-DD>.nc, ecmwf_s2s_pl_<YYYY-MM-DD>.nc).
FORECAST_INPUT_ROOT=data/forecasts
# ECMWF Open Data mirrors, tried in order (default: ecmwf, then aws; see
# config/data_sources.yaml). A URL serves a local copy laid out like data.ecmwf.int.
# ECMWF_OPENDATA_MIRRORS=ecmwf,aws
# Register the reviewed descriptors in config/model_registry at startup.
AUTO_REGISTER_MODELS=true
# Optional: the official ICPAC Word bulletin template, once supplied.
BULLETIN_TEMPLATE_PATH=
# Optional: an authoritative mask outside the repository.
# ICPAC_MASK_PATH=
ENABLE_SLURM=false
# Set GIT_COMMIT to the deployed source revision in image deployments.

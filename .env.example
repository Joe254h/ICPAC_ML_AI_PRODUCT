# Copy to .env for local runs. Never commit real values: .env is git-ignored.
DATABASE_URL=sqlite:///data/prototype.db
# Supabase / PostgreSQL (install the "postgres" extra); postgres:// URLs are accepted as is:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
# Copilot (docs/chatbot.md). Recommended: Claude through the Anthropic API.
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=low
LLM_PROVIDER=mock
LLM_BASE_URL=http://localhost:8001/v1
LLM_MODEL=qwen-prototype
LLM_API_KEY=
# true: an OpenAI-compatible model with tool calling answers like Claude does.
LLM_TOOLS=false
# Free Gemini (docs/chatbot.md): LLM_PROVIDER=openai_compatible, LLM_TOOLS=true,
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai,
# LLM_MODEL=gemini-3.8-flash, LLM_REASONING_EFFORT=low, LLM_API_KEY=<AI Studio key>.
# A refused model gives way to the next of LLM_FALLBACK_MODELS (Gemini: current Flash models).
# Groq Qwen: set to none; leave empty for endpoints that do not accept this field.
LLM_REASONING_EFFORT=
# A model on a CPU server (docs/self-hosted-llm.md): wait longer and send fewer past messages.
LLM_TIMEOUT_SECONDS=20
LLM_HISTORY_MESSAGES=12
# true: wake a model that scales to zero when the Copilot page opens.
LLM_WARM_UP=false
# Verified model artifacts (descriptor paths are relative to this root).
ARTIFACT_ROOT=artifacts
# CHIRPS days (verification) and dekads (monitoring) are kept under DATA_ROOT/chirps.
DATA_ROOT=data/observations
# Optional: another server laid out like data.chc.ucsb.edu (a mirror or the test server).
# CHIRPS_BASE_URL=
# Optional: the 1991-2020 CHIRPS dekads (NetCDF), for percent of normal on Monitoring.
# CHIRPS_DEKAD_CLIMATOLOGY=
# Optional: another server laid out like TAMSAT's (dekads kept under DATA_ROOT/tamsat).
# TAMSAT_BASE_URL=
# Bulletin approval by email (docs/operations.md). Without SMTP_HOST, bulletins are
# approved and published on the website only. Gmail: smtp.gmail.com, 587, an app password.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURITY=starttls
# MAIL_FROM=
# BULLETIN_REVIEWERS=reviewer@example.org, second.reviewer@example.org
# BULLETIN_PUBLISHERS=
# BULLETIN_DISTRIBUTION=
# PUBLIC_SITE_URL=http://127.0.0.1:3000
# EMAIL_ACTION_SECRET=
# Testing: write the emails to this folder instead of sending them.
# MAIL_OUTBOX_DIR=
# Forecast product packages are written to RUN_ROOT/forecasts (persistent, shared storage).
RUN_ROOT=data/runs
# ECMWF ensembles downloaded from ECMWF Open Data, and any supplied input files
# (ecmwf_s2s_tp_<YYYY-MM-DD>.nc, ecmwf_s2s_pl_<YYYY-MM-DD>.nc).
FORECAST_INPUT_ROOT=data/forecasts
# ECMWF Open Data mirrors, tried in order (default: ecmwf, then aws; see
# config/data_sources.yaml). A URL serves a local copy laid out like data.ecmwf.int.
# ECMWF_OPENDATA_MIRRORS=ecmwf,aws
# Register the reviewed descriptors in config/model_registry at startup.
AUTO_REGISTER_MODELS=true
# Optional: the official ICPAC Word bulletin template, once supplied.
BULLETIN_TEMPLATE_PATH=
# Optional: an authoritative mask outside the repository.
# ICPAC_MASK_PATH=
ENABLE_SLURM=false
# Set GIT_COMMIT to the deployed source revision in image deployments.
# Frontend (Vercel): free CARTO basemaps key for the interactive maps' raster tiles.
# NEXT_PUBLIC_CARTO_KEY=
# In staff mode, manual bulletin writes require this backend-only secret (at least 32 characters).
# Generate a random value and give it only to trusted bulletin operators. Never NEXT_PUBLIC_*.
BULLETIN_OPERATOR_KEY=
# Preferred: one distinct key per named person. Backend only; never NEXT_PUBLIC_*.
# STAFF_CREDENTIALS=[{"name":"Joe254h","key":"replace-with-at-least-32-random-characters","roles":["admin"]}]
# Other roles: operator, reviewer, publisher, chat. Admin has all roles.
STAFF_CREDENTIALS=
# Public evaluation: no login; all workflows are available to visitors.
# Change back to staff to restore named access with the saved credentials.
ACCESS_MODE=staff
RELEASE_MODE=evaluation
OPERATION_WORKER_ENABLED=true
LLM_TOTAL_SECONDS=120
# Opt-in daily connected workflow (UTC); requires the operation worker and one replica.
AUTOMATION_SCHEDULER_ENABLED=false
AUTOMATION_DAILY_HOUR_UTC=10
# Reviewed external requests; provider keys stay in server secret configuration.
EXTERNAL_ACQUISITION_ENABLED=false
EXTERNAL_FEED_PROFILES=
EXTERNAL_FEED_PROFILES_SHA256=
# Reviewed, window-specific climatology/temperature/threshold artifacts inside DATA_ROOT.
WEEKLY_REFERENCE_MANIFEST=
WEEKLY_REFERENCE_MANIFEST_SHA256=
# Operator-side SLURM bridge on the HPC host, not an arbitrary web command runner.
HPC_SCRIPT_ROOT=
HPC_WORKFLOW_SCRIPT=
HPC_WORKFLOW_SHA256=
HPC_RECEIPT_ROOT=
